PORT=3000

# Local: apuntá a una Postgres corriendo en tu máquina.
DATABASE_URL=postgres://user:password@localhost:5432/car_companion

# Producción (Railway): NO copies este valor acá. Railway inyecta DATABASE_URL
# automáticamente como variable de entorno del servicio (ver Railway dashboard
# → servicio car-companion → Variables). Para probar contra la base de Railway
# desde tu máquina local, copiá el valor real desde ahí a tu .env local
# (Postgres → pestaña Variables → DATABASE_URL), nunca lo subas a git.

JWT_SECRET=cambiar-esto-por-algo-random-y-secreto
