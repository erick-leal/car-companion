# Defaults del proyecto — se aplican al correr `idf.py set-target` por primera vez
# o `idf.py -DSDKCONFIG_DEFAULTS=sdkconfig.defaults reconfigure`.
#
# Habilita Bluetooth con el stack NimBLE (más liviano que Bluedroid, y es el
# recomendado por Espressif para casos "solo BLE central", como este).

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y

# Deshabilitar Bluedroid explícitamente (no lo necesitamos, y ahorra flash/RAM)
CONFIG_BT_BLUEDROID_ENABLED=n

# Solo rol central (nosotros conectamos al Vgate, no al revés)
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n

# PSRAM: la placa de prototipo actual (M5Stack Core2, módulo D0WDQ6-V3) trae 8MB,
# lo activamos por si LVGL lo necesita para buffers. Modo quad porque el ESP32
# clásico (a diferencia del S3) no soporta PSRAM en modo octal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y

# Flash real del Core2: 16MB (el default de ESP-IDF es 2MB y generaba un warning
# de tamaño en cada boot — ver log de flasheo del 19 ago).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
