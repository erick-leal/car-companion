# Defaults del proyecto — se aplican al correr `idf.py set-target` por primera vez
# o `idf.py -DSDKCONFIG_DEFAULTS=sdkconfig.defaults reconfigure`.
#
# Habilita Bluetooth con el stack NimBLE (más liviano que Bluedroid, y es el
# recomendado por Espressif para casos "solo BLE central", como este).

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y

# Deshabilitar Bluedroid explícitamente (no lo necesitamos, y ahorra flash/RAM)
CONFIG_BT_BLUEDROID_ENABLED=n

# Solo rol central (nosotros conectamos al Vgate, no al revés)
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n

# Subido de 4096 (default) a 8192: los callbacks de notify de NimBLE
# terminan bajando por toda la cadena obd_driver -> pid_engine -> state_store
# -> notify_subscribers -> [storage (puede escribir a FAT), ui (toma el
# mutex de LVGL y hace varios snprintf de floats)], todo en el stack de ESTA
# tarea. Encontrado en auditoria (24 ago) por el mismo patron que ya causo
# un bug real de corrupcion silenciosa en connectivity_task (stack corto +
# operacion pesada = "PK verify failed" en vez de crash limpio) — no hay
# guru meditation que avise si esto se queda corto, asi que se subio antes
# de que pase en vez de esperar a diagnosticarlo despues.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192

# PSRAM: la placa de prototipo actual (M5Stack Core2, módulo D0WDQ6-V3) trae 8MB,
# lo activamos por si LVGL lo necesita para buffers. Modo quad porque el ESP32
# clásico (a diferencia del S3) no soporta PSRAM en modo octal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y

# Flash real del Core2: 16MB (el default de ESP-IDF es 2MB y generaba un warning
# de tamaño en cada boot — ver log de flasheo del 19 ago).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Tabla de particiones propia (partitions.csv): agrega una particion FAT
# dedicada para el historial de viajes — la tabla "single app" default no
# reserva espacio para eso y deja ~15MB de los 16MB de flash sin usar.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LVGL: la fuente montserrat_20 que usa ui/ui.c no viene habilitada por
# default (solo 14 lo esta), y necesitamos I2C driver legacy para el AXP192.
CONFIG_LV_FONT_MONTSERRAT_20=y
# montserrat_28 para el numero grande de RPM del dashboard.
CONFIG_LV_FONT_MONTSERRAT_28=y

# El panel SPI del Core2 (ILI9342C) espera los pixeles RGB565 con los bytes
# al reves de como LVGL los arma por default — sin esto, cada pixel sale con
# los canales de color mezclados (visto en hardware real el 19 ago: texto
# con "fringing" de colores, fondo negro se veia bien porque 0x0000 da igual
# con los bytes al reves).
CONFIG_LV_COLOR_16_SWAP=y

# Pool de memoria interno de LVGL (para lv_obj_t, estilos, etc. — NO es el
# buffer de dibujo). El default de 32KB se desbordo con un test de ~300
# objetos chicos (crash real en hardware el 19 ago, dentro de LVGL mismo).
# La pantalla real usa muy pocos objetos (labels), pero subimos el pool con
# margen para no volver a pisar esto.
CONFIG_LV_MEM_SIZE_KILOBYTES=48

# Revision minima de chip soportada: el M5 real es rev v3.1 (confirmado en el
# log de boot). Bajarla de "v0.0" (default) a "v3.0" desactiva
# SPIRAM_CACHE_WORKAROUND (un fix de compilador solo necesario para el bug de
# cache de PSRAM del rev 1, "no requerido para el rev 3 en adelante" segun el
# propio texto de ayuda del Kconfig) — sin esto, agregar WiFi (connectivity,
# 23 ago) desbordaba iram0_0_seg por ~7KB al linkear (BLE + WiFi + TLS ya
# estan justos de IRAM en el ESP32 clasico).
CONFIG_ESP32_REV_MIN_3=y

# WiFi (connectivity, 23 ago) comparte el ESP32 clasico con NimBLE (BT) y
# LVGL, los tres justos de RAM interna. Los buffers de WiFi por default
# (pensados para un dispositivo que SOLO hace WiFi) reservaban ~42KB de RAM
# interna al arrancar y agotaban lo que quedaba libre -- esp_wifi_init()
# fallaba con "malloc buffer fail" y (antes de sacar los ESP_ERROR_CHECK de
# connectivity.c) eso *aborteaba todo el dispositivo*, justo lo que
# connectivity.h dice que nunca debe pasar. Bajado a valores chicos:
# suficiente para sync HTTP ocasional, no para WiFi de alto throughput.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16

# Mismo problema de RAM interna justa, ahora del lado de mbedTLS: el primer
# intento real de sync fallaba en el handshake TLS con
# "mbedtls_ssl_setup returned -0x7F00" (MBEDTLS_ERR_SSL_ALLOC_FAILED) -- los
# buffers TLS por default (16KB in + 4KB out = 20KB) no entraban. Bajado el
# buffer de entrada a 8KB (de sobra para las respuestas JSON chicas del
# backend) y habilitado DYNAMIC_BUFFER (los buffers se allocan solo cuando
# hace falta enviar/recibir y se liberan despues, en vez de quedar
# reservados todo el rato que dura la conexion).
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# La causa de fondo real (encontrada con CONFIG_LOG_DEFAULT_LEVEL_DEBUG
# temporal + heap_caps_get_largest_free_block, 23 ago): no era falta de RAM
# interna total (quedaban ~27KB libres) sino FRAGMENTACION -- el bloque
# contiguo mas grande disponible era de solo 12KB, y el handshake TLS real
# necesita ir pidiendo varios bloques de a poco (sesion, contexto X.509,
# buffers de trabajo) que se van fragmentando entre si compitiendo con
# NimBLE+LVGL+WiFi ya instalados en la misma RAM interna. Mover las
# allocaciones de mbedTLS a PSRAM (4MB libres, sin competencia con nadie
# mas) evita el problema de raiz en vez de seguir ajustando tamaños de
# buffer a ciegas.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
