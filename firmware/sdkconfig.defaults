# Defaults del proyecto — se aplican al correr `idf.py set-target` por primera vez
# o `idf.py -DSDKCONFIG_DEFAULTS=sdkconfig.defaults reconfigure`.
#
# Habilita Bluetooth con el stack NimBLE (más liviano que Bluedroid, y es el
# recomendado por Espressif para casos "solo BLE central", como este).

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y

# Deshabilitar Bluedroid explícitamente (no lo necesitamos, y ahorra flash/RAM)
CONFIG_BT_BLUEDROID_ENABLED=n

# Solo rol central (nosotros conectamos al Vgate, no al revés)
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n

# PSRAM: la placa de prototipo actual (M5Stack Core2, módulo D0WDQ6-V3) trae 8MB,
# lo activamos por si LVGL lo necesita para buffers. Modo quad porque el ESP32
# clásico (a diferencia del S3) no soporta PSRAM en modo octal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y

# Flash real del Core2: 16MB (el default de ESP-IDF es 2MB y generaba un warning
# de tamaño en cada boot — ver log de flasheo del 19 ago).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Tabla de particiones propia (partitions.csv): agrega una particion FAT
# dedicada para el historial de viajes — la tabla "single app" default no
# reserva espacio para eso y deja ~15MB de los 16MB de flash sin usar.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LVGL: la fuente montserrat_20 que usa ui/ui.c no viene habilitada por
# default (solo 14 lo esta), y necesitamos I2C driver legacy para el AXP192.
CONFIG_LV_FONT_MONTSERRAT_20=y
# montserrat_28 para el numero grande de RPM del dashboard.
CONFIG_LV_FONT_MONTSERRAT_28=y

# El panel SPI del Core2 (ILI9342C) espera los pixeles RGB565 con los bytes
# al reves de como LVGL los arma por default — sin esto, cada pixel sale con
# los canales de color mezclados (visto en hardware real el 19 ago: texto
# con "fringing" de colores, fondo negro se veia bien porque 0x0000 da igual
# con los bytes al reves).
CONFIG_LV_COLOR_16_SWAP=y

# Pool de memoria interno de LVGL (para lv_obj_t, estilos, etc. — NO es el
# buffer de dibujo). El default de 32KB se desbordo con un test de ~300
# objetos chicos (crash real en hardware el 19 ago, dentro de LVGL mismo).
# La pantalla real usa muy pocos objetos (labels), pero subimos el pool con
# margen para no volver a pisar esto.
CONFIG_LV_MEM_SIZE_KILOBYTES=48
